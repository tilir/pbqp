    set(plain_optimized_output "${output}")
  endif()
  if(NOT error STREQUAL "")
    message(FATAL_ERROR "Ordinary solver output acquired diagnostics")
  endif()
  run(0 "${PBQP}" "--solve=${solver}" --verbose "${EXAMPLE}")
  if(NOT output STREQUAL plain_output)
    message(FATAL_ERROR "Verbose changed ${solver} solution output")
  endif()
  contains("${error}" "solver: ${solver}")
  contains("${error}" "thread limit: 1")
  contains("${error}" "heartbeat: disabled")
  contains("${error}" "problem: nodes=")
  contains("${error}" "result quality:")
  if(solver STREQUAL "bnb" OR solver STREQUAL "bnbopt")
    contains("${error}" "search: preliminary bounds: lower=0; upper=0")
  endif()
endforeach()
