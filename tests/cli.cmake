file(MAKE_DIRECTORY "${WORK}")

function(run expected)
  execute_process(COMMAND ${ARGN}
    WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${status}" STREQUAL "${expected}")
    message(FATAL_ERROR "${ARGN}: expected exit ${expected}, got ${status}\n${output}\n${error}")
  endif()
  set(output "${output}" PARENT_SCOPE)
  set(error "${error}" PARENT_SCOPE)
endfunction()

function(contains text expected)
  string(FIND "${text}" "${expected}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Expected '${expected}' in '${text}'")
  endif()
endfunction()

run(0 "${PBQP}" --help)
contains("${output}" "--solve=SOLVER")
contains("${output}" "naive")
run(0 "${PBQP}" --solve=naive "${EXAMPLE}")
contains("${output}" "COST 0\n")
run(0 "${PBQP}" "${EXAMPLE}" --solve naive)
contains("${output}" "COST 0\n")
file(COPY_FILE "${EXAMPLE}" "${WORK}/input with spaces.pbqp")
run(0 "${PBQP}" --solve=naive "${WORK}/input with spaces.pbqp")
file(COPY_FILE "${EXAMPLE}" "${WORK}/--input.pbqp")
run(0 "${PBQP}" --solve=naive -- --input.pbqp)

run(1 "${PBQP}")
contains("${error}" "--help")
run(1 "${PBQP}" --solve=unknown does-not-exist.pbqp)
contains("${error}" "unknown solver")
run(1 "${PBQP}" --solve=naive --solve=naive "${EXAMPLE}")
contains("${error}" "duplicate option")
run(1 "${PBQP}" --solve= "${EXAMPLE}")
run(1 "${PBQP}" --solve)
run(1 "${PBQP}" --solve=naive)
run(1 "${PBQP}" --solve=naive "${EXAMPLE}" "${EXAMPLE}")
run(1 "${PBQP}" --unknown=naive "${EXAMPLE}")
file(WRITE "${WORK}/infeasible.pbqp" "PBQP 1 NODES 1 EDGES 0 NODE 0 1 INF END\n")
run(2 "${PBQP}" --solve=naive "${WORK}/infeasible.pbqp")
contains("${error}" "no feasible tuple")

run(0 "${GENERATOR}" --help)
contains("${output}" "--nodes=N")
contains("${output}" "--output=FILE")
run(0 "${GENERATOR}" --nodes=5 --edges=7 --max-options=3 --seed=42 "--output=${WORK}/random one.pbqp")
run(0 "${GENERATOR}" --seed 42 --output "${WORK}/random two.pbqp" --max-options 3 --edges 7 --nodes 5)
file(SHA256 "${WORK}/random one.pbqp" first)
file(SHA256 "${WORK}/random two.pbqp" second)
if(NOT first STREQUAL second)
  message(FATAL_ERROR "Named option spelling/order changed seeded generation")
endif()
run(0 "${GENERATOR}" --nodes=0 --edges=0 --max-options=1 --seed=0 "--output=${WORK}/empty.pbqp")
run(0 "${PBQP}" --solve=naive "${WORK}/empty.pbqp")
contains("${output}" "COST 0\n")

run(1 "${GENERATOR}")
run(1 "${GENERATOR}" 5 7 3 42 "${WORK}/old.pbqp")
contains("${error}" "named options")
run(1 "${GENERATOR}" --nodes=-1 --edges=0 --max-options=1 --seed=0 "--output=${WORK}/bad.pbqp")
contains("${error}" "--nodes")
run(1 "${GENERATOR}" --nodes=999999999999999999999999999999999999)
run(1 "${GENERATOR}" --nodes=0 --edges=0 --max-options=1 --seed=0)
contains("${error}" "--output")
run(1 "${GENERATOR}" --nodes=0 --nodes=1)
contains("${error}" "duplicate option")
run(1 "${GENERATOR}" --unknown=0)
run(1 "${GENERATOR}" --nodes --edges=0)
run(1 "${GENERATOR}" --nodes=0 --edges=0 --max-options=0 --seed=0 "--output=${WORK}/bad.pbqp")
