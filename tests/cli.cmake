# 2^65 tuples exceed uint64_t. Even an all-forbidden input must not emit an
# early percent due to overflow or confuse visited tuples with allowed ones.
set(huge "PBQP 1\nNODES 65\nEDGES 0\n")
foreach(node RANGE 0 64)
  string(APPEND huge "NODE ${node} 2\nINF INF\n")
endforeach()
string(APPEND huge "END\n")
file(WRITE "${WORK}/huge.pbqp" "${huge}")
execute_process(COMMAND "${PBQP}" --solve=naive --heartbeat "${WORK}/huge.pbqp"
  TIMEOUT 0.25 RESULT_VARIABLE huge_status OUTPUT_VARIABLE huge_output ERROR_VARIABLE huge_error)
if(NOT huge_status MATCHES "timeout" OR NOT huge_output STREQUAL "" OR NOT huge_error STREQUAL "")
  message(FATAL_ERROR "Overflow-sized search reported early progress: ${huge_status}\n${huge_error}")
endif()
run(2 "${PBQP}" --solve=bnb --numthreads=4 --heartbeat "${WORK}/huge.pbqp")
contains("${error}" "${dots}\nno feasible tuple")
# Equal-cost pruning must close 2^65 tied optima without full enumeration.
string(REPLACE "INF INF" "0 0" huge_feasible "${huge}")
file(WRITE "${WORK}/huge-feasible.pbqp" "${huge_feasible}")
run(0 "${PBQP}" --solve=bnb --numthreads=4 --heartbeat "${WORK}/huge-feasible.pbqp")
contains("${output}" "COST 0\n")
if(NOT error STREQUAL "${dots}\n")
  message(FATAL_ERROR "Pruned 2^65-tuple search reported incorrect progress")
endif()

