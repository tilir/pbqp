  if(placement STREQUAL before)
    run(1 "${PBQP}" -Werror --solve=naive --unrecognized=value "${EXAMPLE}")
  else()
    run(1 "${PBQP}" --solve=naive --unrecognized=value -Werror "${EXAMPLE}")
  endif()
  contains("${error}" "unrecognized option: --unrecognized")
  contains("${error}" "warning treated as error")
  if(NOT output STREQUAL "")
    message(FATAL_ERROR "-Werror ran the solver despite an unknown option")
  endif()
endforeach()
